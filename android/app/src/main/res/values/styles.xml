<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Цвет за системными полосами при edge-to-edge = фон игры (styles.css, bg). -->
        <item name="android:windowBackground">#12141a</item>
    </style>


    <!-- Пускова тема. Два виправлення по плейтесту релізної збірки 16.10.
         1. `windowActionBar`/`windowNoTitle` — без них над грою на **кожному** екрані висіла біла
            смуга із заголовком «Inside the Box». Capacitor перемикає активність на
            `AppTheme.NoActionBar` у `BridgeActivity.onCreate`, але наш `MainActivity` ще до
            `super.onCreate` викликає `EdgeToEdge.enable`, а той чіпає decor — і AppCompat встигає
            зібрати його з заголовком за пусковою темою. Надійніше не перебудовувати порядок
            виклику, а прибрати заголовок із самої пускової теми: тоді черговість не важлива.
            `postSplashScreenTheme` додано поруч — штатний спосіб передати керування справжній темі.
         2. Фон — колір гри замість `@drawable/splash`: та картинка це дефолтна заставка Capacitor
            (білий аркуш із блакитним логотипом), і запуск починався зі спалаху чужого бренду. -->
    <!-- 18.10: виправлення 16.10 не спрацювало — `windowActionBar`/`windowNoTitle` без префікса — це
         атрибути AppCompat, а `Theme.SplashScreen` системна і їх не читає; смуга була системна.
         Потрібні саме `android:`-атрибути. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#12141a</item>
        <item name="windowSplashScreenBackground">#12141a</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>